<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/venta_card_bg"
    android:padding="@dimen/gap_md"
    android:layout_marginBottom="@dimen/gap_sm">

    <!-- Top row: thumb + name/detail + subtotal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/venta_thumb_bg">

            <ImageView
                android:id="@+id/iconoItem"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/primary"
                tools:src="@drawable/ic_local_drink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/gap_sm"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nombreItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_lg"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Coca-Cola 500 ml" />

            <TextView
                android:id="@+id/detalleItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_semibold"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label"
                tools:text="2 × Bs 8" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtotalItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_sm"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subheading"
            tools:text="Bs 16" />
    </LinearLayout>

    <!-- Stepper row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_sm"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnMenos"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:background="@drawable/venta_stepper_minus_bg"
            android:src="@drawable/ic_remove"
            app:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/cantidadItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/gap_sm"
            android:minWidth="20dp"
            android:gravity="center"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_lg"
            tools:text="2" />

        <ImageView
            android:id="@+id/btnMas"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:background="@drawable/venta_stepper_plus_bg"
            android:src="@drawable/ic_add"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
