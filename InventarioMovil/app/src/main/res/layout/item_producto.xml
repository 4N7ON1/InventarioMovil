<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un producto en la lista del inventario.
     Arriba: ícono, nombre, categoría y precio.  Medio: cuántos quedan y su estado.
     Abajo: botones Editar y Eliminar a la vista, para no depender de gestos escondidos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/shape_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/producto_icono"
            android:layout_width="@dimen/avatar_large"
            android:layout_height="@dimen/avatar_large"
            android:background="@drawable/shape_rounded_surface_alt"
            android:contentDescription="@null"
            android:padding="14dp"
            android:scaleType="fitCenter"
            app:tint="@color/primary"
            tools:src="@drawable/ic_local_drink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/producto_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_extrabold"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                tools:text="Coca-Cola 500 ml" />

            <TextView
                android:id="@+id/producto_categoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_medium"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Bebidas" />
        </LinearLayout>

        <TextView
            android:id="@+id/producto_precio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="@color/primary"
            android:textSize="20sp"
            tools:text="Bs 8.00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/producto_stock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            tools:text="Quedan 15 unidades" />

        <LinearLayout
            android:id="@+id/estado_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/estado_punto"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_status_dot" />

            <TextView
                android:id="@+id/estado_texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_extrabold"
                android:textColor="@color/ok_fg"
                android:textSize="13sp"
                tools:text="Disponible" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/stroke_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEditarProducto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/shape_pill_primary"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="Editar"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnEliminarProducto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/shape_chip_unselected"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="Eliminar"
            android:textColor="@color/err_fg"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
