<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para conectarse a la API por la red -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic permite usar http:// (sin https) con el servidor local XAMPP -->
    <application
        android:name=".InventarioApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventarioMovil">

        <!-- LoginActivity: es la primera pantalla que se abre (LAUNCHER) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />

        <!-- InventarioActivity -->
        <activity
            android:name=".InventarioActivity"
            android:exported="false"
            android:label="@string/my_inventory" />

        <!-- VentaActivity -->
        <activity
            android:name=".VentaActivity"
            android:exported="false"
            android:label="@string/new_sale_title" />

        <activity android:name=".ProductoFormActivity" android:exported="false" />
        <activity android:name=".CategoriasActivity" android:exported="false" />
        <activity android:name=".HistorialActivity" android:exported="false" />
        <activity android:name=".ConfiguracionActivity" android:exported="false" />

    </application>

</manifest>
